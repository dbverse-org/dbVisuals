{
  "name": "dbvisuals-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:r-package": "tsc -b && vite build --outDir ../../r-package/inst/sqlrooms --emptyOutDir",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:bridge": "node scripts/check-canvas-bridge.mjs && node scripts/check-spatial-bounds.mjs",
    "test:versions": "node scripts/check-viz-versions.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:bridge && npm run test:versions",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@duckdb/duckdb-wasm": "1.32.0"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.3",
    "@deck.gl/core": "^9.3.3",
    "@deck.gl/extensions": "^9.3.3",
    "@deck.gl/geo-layers": "^9.3.3",
    "@deck.gl/mesh-layers": "^9.3.3",
    "@deck.gl/react": "^9.3.3",
    "@deck.gl/widgets": "^9.3.3",
    "@geoarrow/deck.gl-layers": "^0.3.2",
    "@geoarrow/geoarrow-js": "0.3.3",
    "@sqlrooms/color-scales": "^0.29.0-rc.7",
    "@sqlrooms/deck": "^0.29.0-rc.7",
    "@sqlrooms/dropzone": "0.29.0-rc.7",
    "@sqlrooms/duckdb": "^0.29.0-rc.7",
    "@sqlrooms/mosaic": "^0.29.0-rc.7",
    "@sqlrooms/room-shell": "0.29.0-rc.7",
    "@sqlrooms/sql-editor": "0.29.0-rc.7",
    "@sqlrooms/ui": "0.29.0-rc.7",
    "@sqlrooms/utils": "0.29.0-rc.7",
    "@uwdata/mosaic-core": "^0.21.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.555.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^15.15.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.5"
  }
}
